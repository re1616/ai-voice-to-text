<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Notes and audio never leave the device via Google cloud backup -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
